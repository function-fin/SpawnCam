local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Controles Oficiais do Roblox
local PlayerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local controls = PlayerModule:GetControls()

-- Variáveis de Estado
local isFreeCam = false
local baseSpeed = 1 
local smoothing = 0.15
local pitch, yaw = 0, 0
local upValue, downValue = 0, 0
local velocity = Vector3.new(0,0,0)

-- Variáveis para o Clique Duplo
local lastClickTime = 0
local doubleClickThreshold = 0.3 -- Tempo máximo entre cliques (300ms)

--- IDs dos Ícones ---
local ID_ATIVADO = "rbxassetid://84436978176233"
local ID_DESATIVADO = "rbxassetid://106559516221683"

-- Interface
local screenGui = Instance.new("ScreenGui", player.PlayerGui)
screenGui.Name = "GhostModeGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true

-- // CONFIGURAÇÃO DE UISCALE SOLICITADA
local UiScale = Instance.new("UIScale", screenGui)
local function UpdateUIScale()
    if not UserInputService.TouchEnabled then
        UiScale.Scale = 1.9 -- 90% maior no PC
    else
        UiScale.Scale = 1.0 -- Tamanho padrão no mobile
    end
end
UpdateUIScale()
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(UpdateUIScale)

local mainButton = Instance.new("ImageButton", screenGui)
mainButton.Name = "FreeCamButton"
mainButton.Size = UDim2.new(0, 70, 0, 70) 
mainButton.Position = UDim2.new(0.05, 0, 0.5, 0)
mainButton.Image = ID_DESATIVADO
mainButton.ScaleType = Enum.ScaleType.Fit
mainButton.BackgroundTransparency = 1
mainButton.BorderSizePixel = 0
mainButton.Active = true

--- SISTEMA DE ARRASTAR ---
local dragging, dragStart, startPos
local hasMoved = false

mainButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        hasMoved = false
        dragStart = input.Position
        startPos = mainButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 8 then hasMoved = true end
        mainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

--- FUNÇÃO PARA ENCERRAR O SCRIPT COMPLETAMENTE ---
local function selfDestruct()
    isFreeCam = false
    RunService:UnbindFromRenderStep("GhostCamUpdate")
    
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then root.Anchored = false end
        if hum then
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = hum
        end
    end
    
    screenGui:Destroy() -- Remove o botão e a interface
    script:Destroy()    -- Encerra o script
end

--- LÓGICA DA CÂMERA ---
local function onRenderStep(dt)
    if not isFreeCam then return end
    local moveVector = controls:GetMoveVector()
    local targetMove = Vector3.new(moveVector.X, upValue - downValue, moveVector.Z)
    
    if targetMove.Magnitude > 0 then
        targetMove = targetMove.Unit * baseSpeed
    end
    
    velocity = velocity:Lerp(targetMove, smoothing)
    local rotationCFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
    camera.CFrame = CFrame.new(camera.CFrame.Position) * rotationCFrame * CFrame.new(velocity)
end

--- ATIVAÇÃO / DESATIVAÇÃO / DOUBLE CLICK ---
mainButton.Activated:Connect(function()
    if hasMoved then return end 

    local currentTime = tick()
    local timeSinceLastClick = currentTime - lastClickTime
    
    if timeSinceLastClick < doubleClickThreshold then
        -- EXECUTA FECHAMENTO COMPLETO
        selfDestruct()
        return
    end
    
    lastClickTime = currentTime

    -- Lógica normal de Toggle
    isFreeCam = not isFreeCam
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if isFreeCam then
        mainButton.Image = ID_ATIVADO
        if root then root.Anchored = true end
        camera.CameraType = Enum.CameraType.Scriptable
        local cx, cy = camera.CFrame:ToEulerAnglesYXZ()
        pitch, yaw = cx, cy
        RunService:BindToRenderStep("GhostCamUpdate", Enum.RenderPriority.Camera.Value, onRenderStep)
    else
        mainButton.Image = ID_DESATIVADO
        velocity = Vector3.new(0,0,0)
        if root then root.Anchored = false end
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = hum
        RunService:UnbindFromRenderStep("GhostCamUpdate")
    end
end)

-- Rotação e Teclas (Controles)
UserInputService.InputChanged:Connect(function(input)
    if isFreeCam and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Delta
            yaw = yaw - (delta.X * 0.004)
            pitch = math.clamp(pitch - (delta.Y * 0.004), -math.rad(89), math.rad(89))
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Space then upValue = 1 end
    if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then downValue = 1 end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.Space then upValue = 0 end
    if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then downValue = 0 end
end)
